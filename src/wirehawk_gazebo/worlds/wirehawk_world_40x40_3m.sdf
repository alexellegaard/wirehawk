<model name="payload">
      <pose>0 0 1.5 0 0 0</pose>
      
      <link name="mass_link">
        <inertial>
          <mass>3.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
          <material>
            <ambient>1.0 0.0 0.0 1</ambient>
            <diffuse>1.0 0.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Elastic-catenary cable plugin: weighted + axially elastic cables.
           linear_density  [kg/m] : cable mass per metre (weight -> sag)
           axial_stiffness [N]    : E*A, cable axial rigidity (stretch)
           max_tension     [N]    : safety clamp on per-cable force
           payload_drag    [N*s/m]: world-frame drag so the system settles -->
      <plugin filename="libCableCatenaryPlugin.so" name="wirehawk::CableCatenaryPlugin">
        <linear_density>0.00258</linear_density>
        <axial_stiffness>98100.0</axial_stiffness>
        <max_tension>5886.0</max_tension>
        <payload_drag>50.0</payload_drag>
        <anchor_height>3.0</anchor_height>
        <gravity>9.80665</gravity>
              <slack_transition_strain>0.0001</slack_transition_strain>
      </plugin>
      
    </model>

  </world>
</sdf>