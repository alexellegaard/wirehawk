# ROS 2 build output
build/
install/
log/
# Python cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
# Editor / IDE artifacts
.vscode/
.idea/
*.swp
*~
# OS artifacts
.DS_Store
# Compiled SOEM bench binaries (no extension) + stray files in src/ethercat.
# Keep the sources (.c/.xml) and the Makefile; ignore everything else.
src/ethercat/*
!src/ethercat/*.c
!src/ethercat/*.xml
!src/ethercat/*.md
!src/ethercat/Makefile
